---
/**
 * Infographic
 *
 * The Kalighat artwork carries NO lettering. Labels are real HTML text
 * positioned over it, so they stay crisp at every size, are selectable,
 * searchable and readable by screen readers — and can be swapped for a
 * Bengali label set later without regenerating the painting.
 *
 * On screens under 700px the labels drop out of position and stack
 * beneath the image as a plain list, because overlaid type at phone
 * width is unreadable no matter how it is set.
 *
 * Usage:
 * <Infographic
 *   src={patTrain}
 *   alt="A freight train of grain wagons runs the width of the frame; in the foreground a hand holds a single grain of bajra in tweezers."
 *   width="bleed"
 *   caption="What the state actually buys. Punjab, 2022-23."
 *   source="Union Ministry of Consumer Affairs, Food and Public Distribution, as reported in The Wire, February 2026."
 *   labels={[
 *     { text: 'PADDY — 18,210,000 tonnes', sub: 'about 7,300 wagon-loads', x: 8,  y: 14, tone: 'indigo' },
 *     { text: 'BAJRA AND JOWAR — 140 tonnes', sub: 'not enough to fill one wagon', x: 58, y: 74, tone: 'ochre' },
 *   ]}
 * />
 */
import { Image } from 'astro:assets';

const {
  src,
  alt,
  caption,
  source,
  labels = [],
  width = 'wide', // 'column' | 'wide' | 'bleed'
} = Astro.props;

const widthClass = width === 'bleed' ? 'bleed' : width === 'wide' ? 'wide' : '';
---

<figure class={`ig ${widthClass}`}>
  <div class="ig__frame">
    <Image src={src} alt={alt} widths={[600, 1000, 1600, 2400]} quality={90} />

    {labels.map((l) => (
      <span
        class={`ig__label ig__label--${l.tone ?? 'ink'}`}
        style={`--x:${l.x}%; --y:${l.y}%;`}
        data-align={l.align ?? 'left'}
      >
        <span class="ig__label-main">{l.text}</span>
        {l.sub && <span class="ig__label-sub">{l.sub}</span>}
      </span>
    ))}
  </div>

  {labels.length > 0 && (
    <ul class="ig__key">
      {labels.map((l) => (
        <li class={`ig__key-item ig__key-item--${l.tone ?? 'ink'}`}>
          <strong>{l.text}</strong>
          {l.sub && <span> — {l.sub}</span>}
        </li>
      ))}
    </ul>
  )}

  {(caption || source) && (
    <figcaption>
      {caption && <span class="ig__caption">{caption}</span>}
      {source && <span class="ig__source">Source: {source}</span>}
    </figcaption>
  )}
</figure>

<style>
  .ig { margin-block: 3.5rem; }

  .ig__frame { position: relative; }

  .ig :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Overlaid labels — desktop and tablet only */
  .ig__label {
    position: absolute;
    left: var(--x);
    top: var(--y);
    max-width: 15rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--body);
    line-height: 1.3;
    pointer-events: none;
  }
  .ig__label[data-align='right'] { transform: translateX(-100%); text-align: right; }
  .ig__label[data-align='center'] { transform: translateX(-50%); text-align: center; }

  .ig__label-main {
    font-family: 'Kalam', cursive;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .ig__label-sub {
    font-size: 1rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  .ig__label--indigo .ig__label-main { color: var(--indigo); }
  .ig__label--ochre  .ig__label-main { color: var(--ochre); }
  .ig__label--alta   .ig__label-main { color: var(--alta); }

  /* Stacked key — mobile only */
  .ig__key {
    display: none;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .ig__key-item { padding-left: 0.85rem; border-left: 3px solid var(--ink); margin-bottom: 0.6rem; }
  .ig__key-item--indigo { border-color: var(--indigo); }
  .ig__key-item--ochre  { border-color: var(--ochre); }
  .ig__key-item--alta   { border-color: var(--alta); }

  @media (max-width: 700px) {
    .ig__label { display: none; }
    .ig__key { display: block; }
  }

  figcaption {
    margin-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .ig__caption { font-style: italic; }
  .ig__source { font-size: 0.75rem; letter-spacing: 0.02em; }

  /* Full-bleed images still need breathing room for their caption */
  .ig.bleed figcaption,
  .ig.bleed .ig__key {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
