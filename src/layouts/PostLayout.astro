---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const { title, standfirst, date, description, ogImage } = frontmatter;

const printed = new Date(date).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---
<BaseLayout title={`${title} — The Fine Print`} description={description ?? standfirst} image={ogImage}>
  <article class="shell flow">
    <h1>{title}</h1>
    {standfirst && <p class="standfirst">{standfirst}</p>}
    <p class="dateline">Achintyarup Ray · <time datetime={date}>{printed}</time></p>

    <slot />
  </article>

  <div class="shell">
    <p class="response-note">
      Corrections and documents welcome —
      <a href={`${import.meta.env.BASE_URL}contact`}>write to me</a>.
    </p>
  </div>

<style>
  .response-note {
    margin-block-start: 4rem;
    padding-block-start: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
</BaseLayout>
