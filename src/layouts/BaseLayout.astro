---
import '../styles/global.css';

const {
  title = 'The Fine Print',
  description = 'What records say, and what they leave out. Long-form reporting on policy, environment, history and literature by Achintyarup Ray, built on RTI replies, archive files and documents prised loose.',
  image = 'og/Fineprint_OG.png',  datePublished,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: ogImage.href,
  url: canonical.href,
  author: {
    '@type': 'Person',
    name: 'Achintyarup Ray',
    url: 'https://achintyarupray.com',
    jobTitle: 'Journalist',
  },
  publisher: {
    '@type': 'Organization',
    name: 'The Fine Print',
    url: 'https://fineprint.achintyarupray.com',
  },
  ...(datePublished ? { datePublished } : {}),
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <meta property="og:site_name" content="The Fine Print" />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="alternate" type="application/rss+xml" title="The Fine Print" href={`${import.meta.env.BASE_URL}rss.xml`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Kalam:wght@400;700&family=Noto+Serif+Bengali:wght@400;600;700&family=Baloo+Da+2:wght@600;700&display=swap"
    rel="stylesheet"
  />
<script data-goatcounter="https://fineprint.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="masthead">
    <div class="masthead__inner">
      <div class="masthead__brand">
        <p class="masthead__title"><a href={import.meta.env.BASE_URL}>The Fine Print</a></p>
        <p class="masthead__byline">Achintyarup Ray · Kolkata</p>
      </div>
      <nav class="masthead__nav" aria-label="Main">
        <a href={import.meta.env.BASE_URL}>Articles</a>
        <a href={`${import.meta.env.BASE_URL}about`}>About</a>
        <a href={`${import.meta.env.BASE_URL}contact`}>Contact</a>
        <a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="footer__inner">
      <span>The Fine Print — written and reported by Achintyarup Ray, Kolkata.</span>
      <span><a href={`${import.meta.env.BASE_URL}contact`}>Write to me</a></span>
    </div>
  </footer>
</body>
</html>
