---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const covers = import.meta.glob('../assets/*.{png,jpg,jpeg,webp}', { eager: true });

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
---
<BaseLayout>
  <div class="shell">
    <p class="lede">
      Longer pieces on policy, environment, history and literature — the
      arguments that need more room than a column allows, and the numbers
      that go with them.
    </p>

    <div class="ornament" aria-hidden="true"><span></span><span></span><span></span></div>

    <ul class="postlist">
      {posts.map((post) => {
        const cover = post.data.cover ? covers[`../assets/${post.data.cover}`]?.default : null;
        return (
          <li>
            <time datetime={post.data.date}>
              {new Date(post.data.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <h2><a href={`${import.meta.env.BASE_URL}${post.slug}`}>{post.data.title}</a></h2>
            {post.data.standfirst && <p>{post.data.standfirst}</p>}
            {cover && (
              <a href={`${import.meta.env.BASE_URL}${post.slug}`} class="postlist__cover">
                <Image src={cover} alt="" widths={[400, 800, 1200]} loading="lazy" />
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<style>
  .lede {
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 32rem;
    margin: 0;
  }
  .lede::first-letter {
    font-family: var(--display);
    font-size: 3.4em;
    line-height: 0.8;
    float: left;
    margin: 0.05em 0.12em 0 0;
    color: var(--ochre);
  }

  .ornament {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-block: 3.5rem;
  }
  .ornament span {
    width: 6px;
    height: 6px;
    transform: rotate(45deg);
    background: var(--ochre);
  }
  .ornament span:nth-child(2) {
    background: var(--ink);
    opacity: 0.55;
  }

  .postlist { list-style: none; margin: 0; padding: 0; }

  .postlist li {
    padding-block: 0 3.5rem;
    border: 0;
    position: relative;
  }
  .postlist li + li { padding-block-start: 3.5rem; }

  .postlist li + li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    border-top: 1px solid var(--rule);
  }
  .postlist li + li::after {
    content: '';
    position: absolute;
    top: -4px;
    left: 50%;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    transform: rotate(45deg);
    background: var(--paper);
    border: 1px solid var(--rule);
  }

  .postlist time {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ochre);
    margin-bottom: 0.6rem;
  }

  .postlist h2 {
    border: 0;
    padding: 0;
    margin: 0 0 0.6rem;
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 1.875rem);
    line-height: 1.15;
  }
  .postlist h2 a { text-decoration: none; }
  .postlist h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--ochre);
    text-underline-offset: 4px;
  }

  .postlist p {
    color: var(--ink-soft);
    max-width: 32rem;
    margin: 0;
  }

  .postlist__cover {
    display: block;
    margin-top: 1.75rem;
    overflow: hidden;
  }
  .postlist__cover img {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.92);
    transition: filter 0.5s ease, transform 0.5s ease;
  }
  .postlist__cover:hover img {
    filter: saturate(1.05);
    transform: scale(1.012);
  }

  @media (prefers-reduced-motion: reduce) {
    .postlist__cover img { transition: none; }
    .postlist__cover:hover img { transform: none; }
  }
</style>
