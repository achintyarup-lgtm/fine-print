---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));
---
<BaseLayout>
  <div class="shell">
    <p class="lede">
      What was sanctioned, what was built, and what got left out of the
      record — files, judgments, RTI replies, and the documents nobody got
      round to publishing.
    </p>

    <ul class="postlist">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date}>
            {new Date(post.data.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <h2><a href={`/${post.slug}`}>{post.data.title}</a></h2>
          {post.data.standfirst && <p>{post.data.standfirst}</p>}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .lede {
    font-size: 1.125rem;
    color: var(--ink-soft);
    max-width: 30rem;
    margin: 0 0 3rem;
  }
</style>
