---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import Subscribe from '../components/Subscribe.astro';
import { SECTIONS } from '../data/sections.js';
import { getStories } from '../lib/posts.js';

const stories = await getStories();
const lead = stories.find((p) => p.data.section === 'investigations') ?? stories[0];
const news = stories.filter((p) => p.data.section === 'news').slice(0, 4);
const onTop = new Set([lead, ...news]);
const counts = Object.fromEntries(SECTIONS.map((s) => [s.slug, stories.filter((p) => p.data.section === s.slug).length]));
---
<BaseLayout>
  <div class="page">
    <section class="lead-row" aria-label="Top stories">
      <div class="lead-row__main">
        <h2 class="rubric" data-section="investigations"><a href={`${import.meta.env.BASE_URL}investigations/`}>Fine Print Investigations</a></h2>
        <StoryCard post={lead} variant="lead" showSection={false} />
      </div>
      <aside class="newsrail" data-section="news" aria-labelledby="news-h">
        <h2 id="news-h" class="rubric"><a href={`${import.meta.env.BASE_URL}news/`}>News <span>· Proper Channel</span></a></h2>
        {news.map((p, i) => <StoryCard post={p} variant={i === 0 ? 'card' : 'line'} showSection={false} />)}
        <a class="sec__all" href={`${import.meta.env.BASE_URL}news/`}>All news →</a>
      </aside>
    </section>


    {SECTIONS.filter((s) => s.slug === 'investigations').map((s) => {
      if (s.slug === 'news') return null;
      const list = stories.filter((p) => p.data.section === s.slug && !onTop.has(p)).slice(0, s.slug === 'investigations' ? 6 : 3);
      return list.length > 0 && (
        <section class="sec" data-section={s.slug} aria-labelledby={`sec-${s.slug}`}>
          <header class="sec__head">
            <h2 id={`sec-${s.slug}`}><a href={`${import.meta.env.BASE_URL}${s.slug}/`}>{s.slug === 'investigations' ? 'More from Fine Print Investigations' : s.name}</a></h2>
            <a class="sec__all" href={`${import.meta.env.BASE_URL}${s.slug}/`}>All {s.short.toLowerCase()} →</a>
          </header>
          <div class="grid">
            {list.map((p) => <StoryCard post={p} showSection={false} />)}
          </div>
        </section>
      );
    })}

    <section class="picker" aria-labelledby="picker-h">
      <h2 id="picker-h" class="rubric">Choose what to read</h2>
      <ul class="picker__grid">
        {SECTIONS.map((s) => (
          <li>
            <a class="picker__tile" href={`${import.meta.env.BASE_URL}${s.slug}/`} data-section={s.slug}>
              <span class="picker__name">{s.name}</span>
              <span class="picker__blurb">{s.blurb}</span>
              <span class="picker__count">{counts[s.slug]} {counts[s.slug] === 1 ? 'story' : 'stories'} →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {SECTIONS.filter((s) => s.slug !== 'investigations').map((s) => {
      if (s.slug === 'news') return null;
      const list = stories.filter((p) => p.data.section === s.slug && !onTop.has(p)).slice(0, s.slug === 'investigations' ? 6 : 3);
      return list.length > 0 && (
        <section class="sec" data-section={s.slug} aria-labelledby={`sec-${s.slug}`}>
          <header class="sec__head">
            <h2 id={`sec-${s.slug}`}><a href={`${import.meta.env.BASE_URL}${s.slug}/`}>{s.slug === 'investigations' ? 'More from Fine Print Investigations' : s.name}</a></h2>
            <a class="sec__all" href={`${import.meta.env.BASE_URL}${s.slug}/`}>All {s.short.toLowerCase()} →</a>
          </header>
          <div class="grid">
            {list.map((p) => <StoryCard post={p} showSection={false} />)}
          </div>
        </section>
      );
    })}

    <div class="page__subscribe"><Subscribe /></div>
  </div>
</BaseLayout>
